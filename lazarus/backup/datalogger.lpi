<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Title Value="INFO1128 - DataLogger"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
      <ActiveWindowIndexAtStart Value="-1"/>
    </General>
    <BuildModes Active="Default">
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="LazSerialPort"/>
        <DefaultFilename Value="vendor/TLazSerial/LazSerialPort.lpk" Prefer="True"/>
      </Item>
      <Item>
        <PackageName Value="TAChartLazarusPkg"/>
      </Item>
      <Item>
        <PackageName Value="LCL"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="datalogger.lpr"/>
        <IsPartOfProject Value="True"/>
        <UsageCount Value="20"/>
      </Unit>
      <Unit>
        <Filename Value="principal.pas"/>
        <IsPartOfProject Value="True"/>
        <UsageCount Value="20"/>
      </Unit>
      <Unit>
        <Filename Value="protocolo_uma.pas"/>
        <IsPartOfProject Value="True"/>
        <UsageCount Value="20"/>
      </Unit>
    </Units>
    <JumpHistory HistoryIndex="-1"/>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="datalogger"/>
    </Target>
    <SearchPaths>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Linking>
      <Debugging>
        <DebugInfoType Value="dsDwarf3"/>
      </Debugging>
    </Linking>
  </CompilerOptions>
</CONFIG>
